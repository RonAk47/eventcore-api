{
  "info": {
    "_postman_id": "2e8e25e9-5d52-4e8d-9e3a-7de9d1b8a001",
    "name": "EventCore API",
    "description": "EventCore in-memory API. Run Health, Authentication, Events, then Validation on a fresh server. Set organizerRegistrationCode and password first. Passwords require at least 8 characters and at most 72 UTF-8 bytes. Event dates/times are UTC. Notifications return queued (accepted, not delivered) or failed (could not enqueue). Separate per-IP login/register limits default to 20/10 attempts per 15 minutes. Optional rate-limit checks are skipped unless runRateLimitChecks=true; they intentionally exhaust these limits. Restart the server or wait for the window before rerunning. JWT_EXPIRES_IN is validated at server startup; digit-only values mean seconds.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "attendeeEmail",
      "value": "attendee@example.com"
    },
    {
      "key": "organizerEmail",
      "value": "organizer@example.com"
    },
    {
      "key": "password",
      "value": "secure-password"
    },
    {
      "key": "organizerRegistrationCode",
      "value": "replace-with-your-code"
    },
    {
      "key": "attendeeToken",
      "value": ""
    },
    {
      "key": "organizerToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "expectedEmailNotification",
      "value": "queued",
      "description": "Use queued when Gmail credentials are configured; failed when they are absent. Queued does not guarantee delivery."
    },
    {
      "key": "runRateLimitChecks",
      "value": "false",
      "description": "Opt in to the optional Collection Runner tests that exhaust auth limits."
    },
    {
      "key": "maxRateLimitAttempts",
      "value": "25",
      "description": "Maximum requests per rate-limit probe; set above your configured login and registration limits."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code === 200).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
