              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.collectionVariables.get('_rateLimitAttempts_login') || 0) + 1;",
                  "const maxAttempts = Number(pm.collectionVariables.get('maxRateLimitAttempts') || 25);",
                  "pm.test(\"Validation error or rate limit\", () => pm.expect([400, 429].includes(pm.response.code)).to.eql(true));",
                  "if (pm.response.code === 400 && attempts < maxAttempts) {",
                  "    pm.collectionVariables.set('_rateLimitAttempts_login', attempts);",
                  "    pm.execution.setNextRequest(pm.info.requestId);",
                  "} else {",
                  "    pm.test(\"HTTP 429\", () => pm.expect(pm.response.code === 429).to.eql(true));",
                  "    pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code === \"RATE_LIMIT_EXCEEDED\").to.eql(true));",
                  "    pm.test(\"Retry-After is positive\", () => pm.expect(Number(pm.response.headers.get('Retry-After')) > 0).to.eql(true));",
                  "    pm.collectionVariables.unset('_rateLimitAttempts_login');",
                  "}"
                ]
              }
