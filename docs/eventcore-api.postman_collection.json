    {
      "name": "Validation",
      "description": "Run after Authentication. Expected error responses count as passing assertions. These requests create no extra accounts or events. Expired tokens, account races, and email internals are covered by npm test.",
      "item": [
        {
          "name": "Reject duplicate email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate\",\n  \"email\": \"{{attendeeEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.expect(pm.response.code === 409).to.eql(true));",
                  "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code === \"EMAIL_EXISTS\").to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject password over 72 bytes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Long password\",\n  \"email\": \"long@example.com\",\n  \"password\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.expect(pm.response.code === 400).to.eql(true));",
                  "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code === \"INVALID_PASSWORD\").to.eql(true));"
                ]
              }
            }
          ]
        },
